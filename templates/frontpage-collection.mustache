{{!
    @template tool_mucatalog/frontpage-collection

    This template renders colletions on the frontpage.

    Example context (json):
    {
        "iscollection": true,
        "name": "Collection 1",
        "shortdescription": "<p>Collection 1</p>\n",
        "url": "https://www.example.com/admin/tool/mucatalog/?sectionid=-1",
        "frontpagepriority": "77"
    }
}}
<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title"><a href="{{url}}">{{name}}</a></h5>
        <div class="card-text">{{{shortdescription}}}</div>
    </div>
</div>
