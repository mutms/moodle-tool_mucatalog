{{!
    @template tool_mucatalog/browse-filters

    This template renders filters in Universal catalog.

    Example context (json):
        {
        "sectionid": 2,
        "hidesectionselect": false,
        "sectionselect": {
            "all": {
                "name": "All items",
                "value": 0,
                "iscurrent": false
            },
            "hascollections": true,
            "collections": [
                {
                    "name": "Collection 1",
                    "value": -1,
                    "iscurrent": false
                }
            ],
            "sections": [
                {
                    "name": "Section 1",
                    "value": "1",
                    "iscurrent": false
                },
                {
                    "name": "Section 2",
                    "value": "2",
                    "iscurrent": true
                }
            ],
            "hassections": true
        },
        "typeselect": [
            {
                "name": "Any type",
                "value": "",
                "iscurrent": true
            },
            {
                "name": "Course",
                "value": "course",
                "iscurrent": false
            },
            {
                "name": "Program",
                "value": "program",
                "iscurrent": false
            },
            {
                "name": "Certification",
                "value": "certification",
                "iscurrent": false
            }
        ],
        "hastypeselect": true
    }
}}

<form id="tool_mucatalog-form-section" onsubmit="event.preventDefault()" class="{{#hidesectionselect}}hidden{{/hidesectionselect}}">
    <div class="form-icon-select">
        <i class="fa fa-bars form-icon" aria-hidden="true"></i>
        <select class="form-select custom-select" name="sectionid" id="tool_mucatalog-sectionid" aria-label="{{#str}}section, tool_mucatalog{{/str}}" title="{{#str}}section, tool_mucatalog{{/str}}">
            <option value="{{sectionselect.all.value}}" {{#sectionselect.all.iscurrent}}selected{{/sectionselect.all.iscurrent}}>{{sectionselect.all.name}}</option>
            {{#sectionselect.hascollections}}
                <optgroup label="{{#str}}collections, tool_mucatalog{{/str}}">
                    {{#sectionselect.collections}}
                        <option value="{{value}}" {{#iscurrent}}selected{{/iscurrent}}>{{name}}</option>
                    {{/sectionselect.collections}}
                </optgroup>
            {{/sectionselect.hascollections}}
            {{#sectionselect.hassections}}
                <optgroup label="{{#str}}sections, tool_mucatalog{{/str}}">
                    {{#sectionselect.sections}}
                    <option value="{{value}}" {{#iscurrent}}selected{{/iscurrent}}>{{name}}</option>
                    {{/sectionselect.sections}}
                </optgroup>
            {{/sectionselect.hassections}}
        </select>
    </div>
    <div class="border-bottom px-3 pb-3 mb-3 w-100"></div>
</form>

<form id="tool_mucatalog-form-filters" onsubmit="event.preventDefault()" data-original-nextlimitfrom="{{nextlimitfrom}}" data-original-hasmore="{{hasmore}}" data-original-sectionid="{{sectionid}}">
    <div class="form-icon-input">
        <input type="text" class="form-control custom-control" name="search" id="tool_mucatalog-search" placeholder="{{#str}}search_placeholder, tool_mucatalog{{/str}}" aria-label="{{#str}}search, tool_mucatalog{{/str}}" title="{{#str}}search, tool_mucatalog{{/str}}">
        <i class="fa fa-magnifying-glass form-icon" aria-hidden="true"></i>
    </div>
    {{#hastypeselect}}
        <div class="pt-3 pb-1"><strong>{{#str}}item_type, tool_mucatalog{{/str}}</strong></div>
        {{#typeselect}}
            <div class="custom-control custom-radio" data-type-radios>
                <input class="form-check-input" type="radio" name="type" value="{{value}}" {{#iscurrent}}checked{{/iscurrent}} id="tool_mucatalog-itemtype-{{value}}-{{uniqid}}">
                <label class="form-check-label" for="tool_mucatalog-itemtype-{{value}}-{{uniqid}}">
                    {{name}}
                </label>
            </div>
        {{/typeselect}}
    {{/hastypeselect}}
</form>

<div class="w-100 pt-2 ps-0 ms-0" style="height: 30px;">
    <div class="hidden loading-icon icon-no-margin" id="tool_mucatalog-browse-reloading">{{#pix}} i/loading, core, {{#str}} loading {{/str}} {{/pix}}</div>
</div>
